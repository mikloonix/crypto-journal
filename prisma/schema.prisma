generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MarketType {
  SPOT
  FUTURE
}

enum Direction {
  LONG
  SHORT
}

enum TradeStatus {
  OPEN
  CLOSED
}

enum LiquidityRole {
  MAKER
  TAKER
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  trades        Trade[]
  riskSettings  RiskSettings?
  
  @@map("users")
}

model RiskSettings {
  id             String   @id @default(cuid())
  userId         String   @unique
  accountBalance Float    @default(10000)
  riskPerTrade   Float    @default(1.0)
  maxDrawdown    Float    @default(20.0)
  riskPerDay     Float    @default(3.0)
  maxOpenRisk    Float    @default(5.0)
  // Default commission (USDT) for trade open/close form prefills
  defaultFeeUsdt Float    @default(0)
  // BingX-style: fee = notional * bps / 10000 (VIP0 perpetual ≈ maker 2, taker 5)
  makerFeeBps    Float    @default(2)
  takerFeeBps    Float    @default(5)
  // 0..5 — ориентир BingX VIP; при смене пересчитываются maker/taker bps в приложении
  bingxVipTier   Int      @default(0)
  updatedAt      DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("risk_settings")
}

model Trade {
  id            String      @id @default(cuid())
  userId        String
  symbol        String
  marketType    MarketType  @default(FUTURE)
  direction     Direction
  status        TradeStatus @default(OPEN)
  
  entries       Entry[]
  exits         Exit[]
  
  strategy      String?
  emotionEntry  String?
  emotionExit   String?
  notes         String?
  
  fee           Float       @default(0)
  funding       Float       @default(0)
  
  createdAt     DateTime    @default(now())
  closedAt      DateTime?
  updatedAt     DateTime    @updatedAt
  /// В корзине (soft delete); null = активен
  deletedAt     DateTime?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, status])
  @@index([userId, deletedAt])
  @@map("trades")
}

model Entry {
  id              String         @id @default(cuid())
  tradeId         String
  price           Float
  volume          Float
  leverage        Int?
  timestamp       DateTime       @default(now())
  fee             Float          @default(0)
  liquidityRole   LiquidityRole  @default(TAKER)

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@map("entries")
}

model Exit {
  id              String         @id @default(cuid())
  tradeId         String
  price           Float
  volume          Float
  timestamp       DateTime       @default(now())
  emotionExit     String?
  fee               Float          @default(0)
  funding           Float          @default(0)
  liquidityRole   LiquidityRole  @default(TAKER)
  deletedAt       DateTime?

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId, deletedAt])
  @@map("exits")
}