generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MarketType {
  SPOT
  FUTURE
}

enum Direction {
  LONG
  SHORT
}

enum TradeStatus {
  OPEN
  CLOSED
}

enum LiquidityRole {
  MAKER
  TAKER
}

enum AccountSource {
  MANUAL
  BINGX
}

enum CashflowType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  trades        Trade[]
  riskSettings  RiskSettings?
  accounts      Account[]
  strategies    Strategy[]
  emotions      Emotion[]
  cashflows     Cashflow[]

  @@map("users")
}

/// Торговый счёт (субсчёт); этап 2.5 — выбор перед вводом сделки и фильтр журнала.
model Account {
  id        String         @id @default(cuid())
  userId    String
  name      String
  isDefault Boolean        @default(false)
  /// Ручной учёт или привязка к API (BingX — позже).
  source    AccountSource @default(MANUAL)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]

  riskSettingsActive RiskSettings[] @relation("RiskSettingsActiveAccount")
  cashflowsPrimary   Cashflow[]      @relation("CashflowPrimaryAccount")
  cashflowsFrom      Cashflow[]      @relation("CashflowFromAccount")
  cashflowsTo        Cashflow[]      @relation("CashflowToAccount")

  @@index([userId])
  @@map("accounts")
}

/// Пополнение / вывод / перевод между счетами (этап 3.5).
model Cashflow {
  id     String       @id @default(cuid())
  userId String
  type   CashflowType
  /// Для DEPOSIT (приход) и WITHDRAWAL (расход).
  accountId String?
  /// Для TRANSFER: списание и зачисление.
  fromAccountId String?
  toAccountId   String?

  amount   Float
  currency String
  /// USDT за 1 единицу `currency`. Для USDT не задан — трактуется как 1.
  fxRate   Float?
  fee      Float?
  timestamp DateTime
  note     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation("CashflowPrimaryAccount", fields: [accountId], references: [id], onDelete: Cascade)
  fromAccount Account? @relation("CashflowFromAccount", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount   Account? @relation("CashflowToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([userId, accountId])
  @@index([userId, fromAccountId])
  @@index([userId, toAccountId])
  @@map("cashflows")
}

model Strategy {
  id        String   @id @default(cuid())
  userId    String
  name      String
  sortOrder Int      @default(0)
  /// Интервал анализа (напр. 15m, 1H, 4H).
  timeframe String?
  /// Кратко: тип сетапа / правило входа.
  setup     String?
  /// Стоп, R, правила управления позицией.
  riskNote  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("strategies")
}

model Emotion {
  id        String   @id @default(cuid())
  userId    String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("emotions")
}

model RiskSettings {
  id             String   @id @default(cuid())
  userId         String   @unique
  accountBalance Float    @default(10000)
  riskPerTrade   Float    @default(1.0)
  maxDrawdown    Float    @default(20.0)
  riskPerDay     Float    @default(3.0)
  maxOpenRisk    Float    @default(5.0)
  // Default commission (USDT) for trade open/close form prefills
  defaultFeeUsdt Float    @default(0)
  // BingX-style: fee = notional * bps / 10000 (VIP0 perpetual ≈ maker 2, taker 5)
  makerFeeBps    Float    @default(2)
  takerFeeBps    Float    @default(5)
  // 0..5 — ориентир BingX VIP; при смене пересчитываются maker/taker bps в приложении
  bingxVipTier   Int      @default(0)
  /// Активный счёт для новых сделок и журнала (этап 2.5)
  activeAccountId String?
  /// Показывать в журнале (открытые/дашборд) все счета; новые сделки всё равно на activeAccountId.
  journalAllAccounts Boolean @default(false)
  /// IANA timezone (этап 3): аналитика, группировки по дню/часу, календарный день на дашборде.
  displayTimeZone    String   @default("UTC")
  updatedAt          DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeAccount Account? @relation("RiskSettingsActiveAccount", fields: [activeAccountId], references: [id], onDelete: SetNull)

  @@map("risk_settings")
}

model Trade {
  id            String      @id @default(cuid())
  userId        String
  accountId     String?
  symbol        String
  marketType    MarketType  @default(FUTURE)
  direction     Direction
  status        TradeStatus @default(OPEN)

  entries Entry[]
  exits   Exit[]

  strategy     String?
  emotionEntry String?
  emotionExit  String?
  notes        String?

  fee     Float @default(0)
  funding Float @default(0)

  createdAt DateTime  @default(now())
  closedAt  DateTime?
  updatedAt DateTime  @updatedAt
  /// В корзине (soft delete); null = активен
  deletedAt DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, deletedAt])
  @@index([userId, accountId])
  @@map("trades")
}

model Entry {
  id              String         @id @default(cuid())
  tradeId         String
  price           Float
  volume          Float
  leverage        Int?
  timestamp       DateTime       @default(now())
  fee             Float          @default(0)
  liquidityRole   LiquidityRole  @default(TAKER)

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@map("entries")
}

model Exit {
  id              String         @id @default(cuid())
  tradeId         String
  price           Float
  volume          Float
  timestamp       DateTime       @default(now())
  emotionExit     String?
  fee               Float          @default(0)
  funding           Float          @default(0)
  liquidityRole   LiquidityRole  @default(TAKER)
  deletedAt       DateTime?

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId, deletedAt])
  @@map("exits")
}